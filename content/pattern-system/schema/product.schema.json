{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Drielo product",
  "type": "object",
  "required": [
    "code",
    "collection",
    "title",
    "pattern_file",
    "website",
    "base_design_id",
    "technique_code"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[PIF][0-9]{4,}-(CS|C2C|TC|LH)$"
    },
    "collection": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "pattern_file": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "skill_level": {
      "type": "string"
    },
    "stitch_type": {
      "type": "string"
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fabric_counts": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "base_design_id": {
      "type": "string",
      "pattern": "^[PIF][0-9]{4,}$"
    },
    "technique_code": {
      "type": "string",
      "enum": [
        "CS",
        "C2C",
        "TC",
        "LH"
      ]
    }
  }
}
